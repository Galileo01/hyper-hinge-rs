{
  "name": "hyper-hinge",
  "productName": "HyperHinge",
  "version": "0.1.0",
  "private": true,
  "description": "Little apps. One laptop hinge. A Nothing-inspired playground.",
  "author": "Henry",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tauri dev --target aarch64-apple-darwin",
    "dev:web": "node scripts/check-assets.mjs && vite --host 127.0.0.1",
    "build": "tauri build --target aarch64-apple-darwin --no-bundle",
    "start": "npm run build && src-tauri/target/aarch64-apple-darwin/release/hyper-hinge",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "package": "node scripts/package.mjs",
    "setup:assets": "node scripts/setup-assets.mjs",
    "format": "prettier --write src scripts tests examples docs README.md AGENTS.md CONTRIBUTING.md package.json package-lock.json vite.config.ts index.html src-tauri/tauri.conf.json src-tauri/capabilities/main.json && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check src scripts tests examples docs README.md AGENTS.md CONTRIBUTING.md package.json package-lock.json vite.config.ts index.html src-tauri/tauri.conf.json src-tauri/capabilities/main.json && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test:package": "node scripts/test-package.mjs",
    "prepare:desktop": "node scripts/check-assets.mjs",
    "build:frontend": "node scripts/check-assets.mjs && tsc --noEmit && vite build",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --target aarch64-apple-darwin",
    "test:web": "node scripts/test-web.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tonejs/midi": "^2.0.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@wdio/cli": "^9.31.7",
    "@wdio/local-runner": "^9.31.7",
    "@wdio/mocha-framework": "^9.31.7",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "webdriverio": "^9.31.7"
  }
}
